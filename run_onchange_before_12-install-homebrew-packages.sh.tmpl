{{- if eq .chezmoi.os "darwin" -}}
#!/usr/bin/env bash
# Re-run whenever the package list in Brewfile changes.
# Brewfile hash: {{ include "Brewfile" | sha256sum }}
set -euo pipefail

setup_homebrew_path() {
  if command -v brew >/dev/null 2>&1; then
    return 0
  fi

  for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew; do
    if [ -x "$brew_path" ]; then
      eval "$("$brew_path" shellenv)"
      return 0
    fi
  done
}

setup_homebrew_path

if ! command -v brew >/dev/null 2>&1; then
  echo "Homebrew is not installed; run scripts/bootstrap-macos.sh first, then rerun chezmoi apply." >&2
  exit 1
fi

brew bundle install --no-upgrade --file {{ joinPath .chezmoi.sourceDir "Brewfile" | quote }}
{{- else -}}
#!/usr/bin/env bash
set -euo pipefail
exit 0
{{- end }}

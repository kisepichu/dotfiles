#!/usr/bin/env bash
# Re-run whenever the plugin list in dot_tmux.conf changes.
# tmux.conf hash: {{ include "dot_tmux.conf" | sha256sum }}
set -euo pipefail

tpm_install="$HOME/.tmux/plugins/tpm/bin/install_plugins"

if [ ! -x "$tpm_install" ]; then
  echo "warning: $tpm_install not found; skipping tmux plugin install" >&2
  exit 0
fi

if ! command -v tmux >/dev/null 2>&1; then
  echo "warning: tmux is not installed; skipping tmux plugin install" >&2
  exit 0
fi

"$tpm_install"

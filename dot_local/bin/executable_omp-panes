#!/usr/bin/env python3
"""Record the omp session open in each tmux pane and reopen it there later (macOS, Linux).

  omp-panes save              record every tmux pane running omp
  omp-panes restore [-n]      type `cd <cwd> && omp <launch flags> --resume <session>`
                              into each recorded pane that sits at a shell prompt

Panes are matched by session:window.pane, which tmux-resurrect restores as-is.
The launch flags come from the process argv; resume/continue/goal flags and
positional prompts are dropped so restoring never re-sends a prompt.
"""
import argparse
import ctypes
import ctypes.util
import json
import os
import re
import shlex
import struct
import subprocess
import sys
import time
from pathlib import Path

STATE = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state") / "omp-panes.json"
OMP_HOME = Path.home() / ".omp"
SHELLS = {"fish", "bash", "zsh", "sh", "dash", "ksh"}
LOCK_RE = re.compile(r"/session-owners/([0-9a-f-]+)\.lock$")

_libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True) if sys.platform == "darwin" else None


def run(*cmd: str) -> str:
    return subprocess.run(cmd, check=True, capture_output=True, text=True, env={**os.environ, "LC_ALL": "C"}).stdout


def proc_argv(pid: int) -> "list[str] | None":
    """Exact argv (ps joins args with spaces and loses quoting)."""
    if _libc is None:
        try:
            parts = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        except OSError:
            return None
        if parts and parts[-1] == b"":
            parts.pop()
        return [p.decode("utf-8", "surrogateescape") for p in parts]
    # macOS: sysctl KERN_PROCARGS2
    argmax = ctypes.c_int()
    size = ctypes.c_size_t(ctypes.sizeof(argmax))
    if _libc.sysctl((ctypes.c_int * 2)(1, 8), 2, ctypes.byref(argmax), ctypes.byref(size), None, 0):  # KERN_ARGMAX
        return None
    buf = ctypes.create_string_buffer(argmax.value)
    size = ctypes.c_size_t(argmax.value)
    if _libc.sysctl((ctypes.c_int * 3)(1, 49, pid), 3, buf, ctypes.byref(size), None, 0):  # KERN_PROCARGS2
        return None
    data = buf.raw[: size.value]
    argc = struct.unpack_from("i", data)[0]
    parts = data[4:].split(b"\0")
    i = 1  # parts[0] is the exec path, followed by NUL padding
    while i < len(parts) and parts[i] == b"":
        i += 1
    return [p.decode("utf-8", "surrogateescape") for p in parts[i : i + argc]]


def value_flags() -> "set[str]":
    flags = set()
    for m in re.finditer(r"^\s+(?:(-\w),\s+)?(--[\w-]+)=<value>", run("omp", "--help"), re.M):
        flags.update(f for f in m.groups() if f)
    if not flags:
        sys.exit("omp-panes: could not read value-taking flags from `omp --help`")
    return flags


def launch_args(argv: "list[str]", vflags: "set[str]") -> "tuple[list[str], list[str]]":
    """Split argv into (args to relaunch with, dropped positional prompts)."""
    out, dropped = [argv[0]], []
    args = argv[1:]
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--":
            dropped += args[i + 1 :]
            break
        name, eq, _ = a.partition("=") if a.startswith("--") else (a, "", "")
        nxt = args[i + 1] if i + 1 < len(args) else None
        if name in ("-r", "--resume"):  # value is optional (picker)
            i += 2 if not eq and nxt is not None and not nxt.startswith("-") else 1
        elif name in ("--restore", "--goal"):
            i += 1 if eq else 2
        elif name in ("-c", "--continue", "--from-claude", "--from-codex"):
            i += 1
        elif a.startswith("-") and a != "-":
            out.append(a)
            if not eq and name in vflags and nxt is not None:
                out.append(nxt)
                i += 1
            i += 1
        else:
            dropped.append(a)
            i += 1
    return out, dropped


def profile_of(argv: "list[str]") -> "str | None":
    for i, a in enumerate(argv):
        if a.startswith("--profile="):
            return a.split("=", 1)[1]
        if a == "--profile" and i + 1 < len(argv):
            return argv[i + 1]
    return None


def open_files(pids: "list[str]") -> "dict[str, dict]":
    """cwd and open file paths per pid: /proc on Linux, lsof on macOS."""
    info: "dict[str, dict]" = {}
    if _libc is None:
        for pid in pids:
            proc = Path("/proc", pid)
            try:
                cwd, fds = os.readlink(proc / "cwd"), os.listdir(proc / "fd")
            except OSError:
                continue
            files = []
            for fd in fds:
                try:
                    files.append(os.readlink(proc / "fd" / fd))
                except OSError:
                    pass
            info[pid] = {"cwd": cwd, "files": files}
        return info
    out = subprocess.run(["lsof", "-nP", "-p", ",".join(pids), "-Fpfn"], capture_output=True, text=True).stdout
    pid = fd = None
    for line in out.splitlines():
        tag, val = line[:1], line[1:]
        if tag == "p":
            pid = val
            info[pid] = {"cwd": None, "files": []}
        elif tag == "f":
            fd = val
        elif tag == "n" and pid:
            if fd == "cwd":
                info[pid]["cwd"] = val
            else:
                info[pid]["files"].append(val)
    return info


def session_from_fds(files: "list[str]") -> "str | None":
    """The session whose owner lock this process holds (taken on the first write)."""
    for f in files:
        m = LOCK_RE.search(f)
        if m:
            for g in files:
                if g.endswith(f"_{m.group(1)}.jsonl"):
                    return g
    return None


def session_from_breadcrumb(tty: str, profile: "str | None") -> "str | None":
    """omp writes <agent dir>/terminal-sessions/<tty> = cwd, session file whenever it switches session."""
    agent = OMP_HOME / "profiles" / profile / "agent" if profile else OMP_HOME / "agent"
    try:
        lines = (agent / "terminal-sessions" / tty.removeprefix("/dev/").replace("/", "-")).read_text().split("\n")
    except FileNotFoundError:
        return None
    return lines[1] if len(lines) > 1 and lines[1].endswith(".jsonl") and Path(lines[1]).is_file() else None


def save(_: argparse.Namespace) -> None:
    panes = [
        dict(zip(("session", "window", "pane", "tty", "path"), line.split("\t")))
        for line in run(
            "tmux", "list-panes", "-a", "-F",
            "#{session_name}\t#{window_index}\t#{pane_index}\t#{pane_tty}\t#{pane_current_path}",
        ).splitlines()
    ]
    # Top-level omp per tty; prefer the foreground process group.
    procs: "dict[str, list[tuple[str, str, bool]]]" = {}
    for line in run("ps", "-Ao", "pid=,ppid=,pgid=,tpgid=,tty=,comm=").splitlines():
        f = line.split(None, 5)
        if len(f) == 6 and os.path.basename(f[5]) == "omp":
            procs.setdefault("/dev/" + f[4], []).append((f[0], f[1], f[2] == f[3]))
    chosen: "dict[str, tuple[str, list[str]]]" = {}
    for tty, cands in procs.items():
        pids = {c[0] for c in cands}
        top = sorted((c for c in cands if c[1] not in pids), key=lambda c: not c[2])
        for pid, _, _ in top:
            argv = proc_argv(int(pid))
            if argv and not (len(argv) > 1 and argv[1].startswith("__omp")):
                chosen[tty] = (pid, argv)
                break
    if not chosen:
        sys.exit(f"omp-panes: no tmux pane is running omp; kept {STATE}")

    vflags = value_flags()
    fds = open_files([pid for pid, _ in chosen.values()])
    entries = []
    for p in panes:
        if p["tty"] not in chosen:
            continue
        pid, argv = chosen[p["tty"]]
        info = fds.get(pid, {"cwd": None, "files": []})
        session_file = session_from_fds(info["files"]) or session_from_breadcrumb(p["tty"], profile_of(argv))
        args, dropped = launch_args(argv, vflags)
        target = f"{p['session']}:{p['window']}.{p['pane']}"
        if dropped:
            print(f"{target}: dropped positional args {dropped}", file=sys.stderr)
        entries.append({
            "session": p["session"], "window": p["window"], "pane": p["pane"],
            "cwd": info["cwd"] or p["path"], "args": args, "session_file": session_file, "argv": argv,
        })
        print(f"{target:<8} {Path(session_file).stem.rsplit('_', 1)[-1] if session_file else '(no session: fresh omp)':<36}  {info['cwd'] or p['path']}")

    STATE.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE.with_suffix(".tmp")
    tmp.write_text(json.dumps({"saved_at": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "panes": entries}, indent=2, ensure_ascii=False))
    tmp.replace(STATE)
    print(f"saved {len(entries)} panes to {STATE}")


def quote(arg: str, shell: str) -> str:
    if re.fullmatch(r"[A-Za-z0-9_@%+=:,./-]+", arg):
        return arg
    if shell == "fish":
        return "'" + arg.replace("\\", "\\\\").replace("'", "\\'") + "'"
    return shlex.quote(arg)


def restore(ns: argparse.Namespace) -> None:
    try:
        state = json.loads(STATE.read_text())
    except FileNotFoundError:
        sys.exit(f"omp-panes: {STATE} not found; run `omp-panes save` first")
    print(f"state saved at {state['saved_at']}")
    for e in state["panes"]:
        label = f"{e['session']}:{e['window']}.{e['pane']}"
        target = "=" + label
        r = subprocess.run(["tmux", "display-message", "-p", "-t", target, "#{pane_current_command}"], capture_output=True, text=True)
        if r.returncode:
            print(f"{label}: skipped, pane not found", file=sys.stderr)
            continue
        shell = os.path.basename(r.stdout.strip()).lstrip("-")
        if shell not in SHELLS:
            print(f"{label}: skipped, pane is running {shell}", file=sys.stderr)
            continue
        cmd = f"cd {quote(e['cwd'], shell)} && " + " ".join(quote(a, shell) for a in e["args"])
        if e["session_file"]:
            cmd += f" --resume {quote(e['session_file'], shell)}"
        print(f"{label}: {cmd}")
        if not ns.dry_run:
            run("tmux", "send-keys", "-t", target, "-l", cmd)
            run("tmux", "send-keys", "-t", target, "Enter")


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("save", help="record every tmux pane running omp").set_defaults(fn=save)
    r = sub.add_parser("restore", help="reopen the recorded sessions in their panes")
    r.add_argument("-n", "--dry-run", action="store_true", help="print the commands without sending them")
    r.set_defaults(fn=restore)
    ns = ap.parse_args()
    ns.fn(ns)


if __name__ == "__main__":
    main()

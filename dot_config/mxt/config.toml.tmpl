# mxt (Matrix TUI client) signed in to Beeper. The Discord bridge it talks to runs on leafeon
# (infra-private: docs/runbooks/leafeon-matrix-bridges.md). A new machine still has to log in
# with `mxt` and then run `:recover`; the bridge ignores devices that are not cross-signed.
# Only settings that differ from mxt's defaults are here, plus read_receipts.
[account]
user_id = "@kisenone:beeper.com"

[ui]
# The default, written out because it is a choice: other users see what this account has read.
read_receipts = "public"

[ui.room_list]
# Bridged channel names start with the Discord server name, which 30 columns cut short.
width = 40
# Rooms with mentions, then rooms that notify, then rooms with only a dim count (mentions-only
# channels), then the ones read most recently; each unread group newest message first. `notify`
# needs mxt >= 0.1.5; older versions skip it with a warning.
sort = "mentions, notify, unread, read"

[ui.timeline]
# Image previews in the timeline (mxt >= 0.1.5; 0.1.4 ignores the table with a warning).
images = "on"
{{- if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") }}

[files]
# WSL has no desktop for xdg-open (mxt's Linux default), so hand files and links to Windows (wslu).
opener = ["wslview"]
{{- end }}

[keymap.normal]
# The keymap list (:map) has no default key.
"<leader>sk" = "help.keymap"
# Jump only between rooms that notify, skipping channels whose only news is a dim count.
"]u" = { action = "room.open", filter = "notify" }
"[u" = { action = "room.open", filter = "notify", pick = "prev" }

[keymap.composer.insert]
# Back in normal mode after sending.
"<CR>" = ["composer.send", "composer.normal"]
